import { LineEdit } from "std-widgets.slint";
import { EntriesStore } from "entries-store.slint";
import { EntryColumn } from "entry-line.slint";
import { PrefillLineEdit } from "prefill-line-edit.slint";
import { SuggestionLineEdit } from "suggestion-line-edit.slint";

// The input fields of an entry, shown in place of a line while it's edited or added. Column
// sizes come from the page so the fields align with the list.
//
// Enter submits, Escape cancels; what that means is up to the owner. Tab and Shift+Tab cycle
// through the fields without leaving the editor, skipping a locked account. The date is
// prefilled with the last entered date when focused while empty, and Up/Down move it by a day.
export component EntryEditor {
    // Whether the account field is shown; without it, the only account is implied.
    in property <bool> show-account;
    // Whether the account is shown but can't be changed: imported entries stay in their account.
    in property <bool> account-locked;
    in property <length> column-spacing;
    in property <length> account-width;
    // Width of the lines' icon column, left empty here.
    in property <length> icon-width;
    in property <length> date-width;
    in property <length> amount-width;
    in property <length> flexible-width;

    in-out property <string> account <=> account-input.text;
    in-out property <string> date <=> date-input.text;
    in-out property <string> name <=> name-input.text;
    in-out property <string> category <=> category-input.text;
    in-out property <string> amount <=> amount-input.text;

    callback submitted();
    callback cancelled();

    property <bool> account-editable: root.show-account && !root.account-locked;
    // The field Tab cycles back to.
    property <EntryColumn> first-column: root.account-editable ? EntryColumn.account : EntryColumn.date;

    // Focuses the field of `column` and selects its text, so typing replaces it. The account
    // column falls back to the date while hidden or locked.
    public function focus-column(column: EntryColumn) {
        if (column == EntryColumn.account && root.account-editable) {
            account-input.focus();
            account-input.select-all();
        } else if (column == EntryColumn.account || column == EntryColumn.date) {
            date-input.focus();
            date-input.select-all();
        } else if (column == EntryColumn.name) {
            name-input.focus();
            name-input.select-all();
        } else if (column == EntryColumn.category) {
            category-input.focus();
            category-input.select-all();
        } else {
            amount-input.focus();
            amount-input.select-all();
        }
    }

    // Starts a new entry: the account is the one entries were last added to, if any, and the
    // other fields are empty. Focuses the account while it's still to be chosen, otherwise the
    // date, prefilled with the last entered date.
    public function reset() {
        account-input.text = root.show-account ? EntriesStore.session-account : "";
        date-input.text = "";
        name-input.text = "";
        category-input.text = "";
        amount-input.text = "";
        if (root.show-account && account-input.text == "") {
            account-input.focus();
        } else {
            date-input.focus();
            // Focus may not change (e.g. Enter pressed in the date input), so prefill explicitly.
            date-input.prefill();
        }
    }

    // Handles keys every field shares; `first`/`last` say where Tab would leave the editor.
    function handle-key(event: KeyEvent, first: bool, last: bool) -> EventResult {
        if (event.text == Key.Escape) {
            root.cancelled();
            return accept;
        }
        let backwards = event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift);
        if (last && event.text == Key.Tab && !backwards) {
            root.focus-column(root.first-column);
            return accept;
        }
        if (first && backwards) {
            root.focus-column(EntryColumn.amount);
            return accept;
        }
        return reject;
    }

    // Not part of the layout, so that it leaves no gap there while hidden; a placeholder in
    // the layout takes its place instead. Declared first to come first in the Tab order.
    account-input := SuggestionLineEdit {
        // After the icon column.
        x: root.icon-width + root.column-spacing;
        y: 0;
        width: root.account-width;
        height: root.height;
        visible: root.show-account;
        enabled: root.account-editable;
        placeholder-text: "Account";
        suggestions: EntriesStore.account-suggestions;
        edited(text) => { EntriesStore.account-edited(text); }
        accepted => { root.submitted(); }
        key-pressed(event) => { return root.handle-key(event, true, false); }
    }

    HorizontalLayout {
        spacing: root.column-spacing;

        Rectangle {
            width: root.icon-width;
        }
        if root.show-account : Rectangle {
            width: root.account-width;
        }
        date-input := PrefillLineEdit {
            width: root.date-width;
            placeholder-text: EntriesStore.date-placeholder;
            prefill-text: EntriesStore.last-date;
            accepted => { root.submitted(); }
            key-pressed(event) => {
                // Up/Down move to the previous/next day.
                if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                    let shifted = EntriesStore.shift-date(self.text, event.text == Key.UpArrow ? -1 : 1);
                    if (shifted != "") {
                        self.text = shifted;
                        self.select-all();
                    }
                    return accept;
                }
                return root.handle-key(event, root.first-column == EntryColumn.date, false);
            }
        }
        name-input := LineEdit {
            horizontal-stretch: 1;
            min-width: root.flexible-width;
            preferred-width: root.flexible-width;
            placeholder-text: "Name";
            accepted => { root.submitted(); }
            key-pressed(event) => { return root.handle-key(event, false, false); }
        }
        category-input := SuggestionLineEdit {
            horizontal-stretch: 1;
            min-width: root.flexible-width;
            preferred-width: root.flexible-width;
            placeholder-text: "Category, e.g. bills.rent";
            suggestions: EntriesStore.category-suggestions;
            // Picking a category continues with its subcategories.
            pick-suffix: ".";
            edited(text) => { EntriesStore.category-edited(text); }
            accepted => { root.submitted(); }
            key-pressed(event) => { return root.handle-key(event, false, false); }
        }
        amount-input := LineEdit {
            width: root.amount-width;
            placeholder-text: "Amount";
            horizontal-alignment: right;
            accepted => { root.submitted(); }
            key-pressed(event) => { return root.handle-key(event, false, true); }
        }
    }
}
