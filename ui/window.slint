import { HorizontalBox } from "std-widgets.slint";
import { SideBar } from "side-bar.slint";
import { EntriesPage, EntriesStore, EntryKind, EntryRow } from "entries-page.slint";

export { EntriesStore, EntryKind, EntryRow }

// Undo/redo of changes to the data (not of text being typed in a field).
export global UndoRedo {
    callback undo();
    callback redo();
}

export component MainWindow inherits Window {
    title: "Monies!";

    // Intercepts the shortcuts before the focused element (e.g. a LineEdit with its own text
    // undo) sees them. Never takes focus itself.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;

        capture-key-pressed(event) => {
            // Undo/redo is off while an entry is edited; the fields then get the keys instead.
            if (event.modifiers.control && !event.modifiers.alt && EntriesStore.editing-id == "") {
                if (event.text == "z" || event.text == "Z") {
                    if (event.modifiers.shift) {
                        UndoRedo.redo();
                    } else {
                        UndoRedo.undo();
                    }
                    return accept;
                }
                if ((event.text == "y" || event.text == "Y") && !event.modifiers.shift) {
                    UndoRedo.redo();
                    return accept;
                }
            }
            return reject;
        }

        HorizontalLayout {
            side-bar := SideBar {
//                title: "How do I hide this label?";
                model: ["Entries", "Summary"];
                // Editing is modal: pages can't be switched meanwhile.
                enabled: EntriesStore.editing-id == "";
            }

            if(side-bar.current-item == 0) : EntriesPage {}
        }
    }
}
