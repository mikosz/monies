import { ListView, Palette } from "std-widgets.slint";
import { EntriesStore } from "entries-store.slint";
import { EntryEditor } from "entry-editor.slint";
import { EntryColumn, EntryKind, EntryLine, EntryRow, RowType } from "entry-line.slint";
import { Page } from "page.slint";
import { SettingsStore } from "settings-store.slint";

export { EntriesStore, EntryKind, EntryRow, RowType }

// The list of entries by date, divided into months. Pressing A adds entries in a line at the
// end of the list until Escape; double-clicking a line edits it in place. Both are modal:
// everything else is dimmed and disabled meanwhile. Without an account, entries can't be added.
export component EntriesPage inherits Page {
    title: "Entries";
    description: "";

    // Header and lines share these constraints so the columns line up.
    property <length> column-spacing: 8px;
    property <length> date-width: 110px;
    property <length> amount-width: 110px;
    property <length> flexible-width: 100px;
    // Padding inside an entry line; the header uses the same so its titles align.
    property <length> line-padding: 8px;

    property <bool> editing: EntriesStore.editing-id != "";
    property <bool> adding: EntriesStore.editing-id == EntriesStore.new-entry-id;
    // Column to focus when an editor opens.
    property <EntryColumn> edit-column;

    // Without input fields, keys (A, and the window's undo shortcuts) need something focused.
    init => { keys.focus(); }

    function start-edit(id: string, column: EntryColumn) {
        root.edit-column = column;
        EntriesStore.editing-id = id;
    }

    function finish-edit() {
        EntriesStore.editing-id = "";
        keys.focus();
    }

    function start-adding() {
        root.start-edit(EntriesStore.new-entry-id, EntryColumn.date);
        root.scroll-to-bottom();
    }

    // Shows the end of the list, where new entries are added. The list only creates the lines
    // in view and estimates the height of the rest, so this may land a bit short; the list
    // corrects it once the actual height is known (see `changed content-height`).
    function scroll-to-bottom() {
        list.content-y = Math.min(0px, list.visible-height - list.content-height);
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (!root.editing && SettingsStore.has-accounts && (event.text == "a" || event.text == "A")
                && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                root.start-adding();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 4px;

            // Layouts have no opacity, hence the rectangle.
            Rectangle {
                opacity: root.editing ? 0.4 : 1;

                HorizontalLayout {
                    padding-left: root.line-padding;
                    padding-right: root.line-padding;
                    spacing: root.column-spacing;

                    Text {
                        width: root.date-width;
                        text: "Date";
                        font-weight: 700;
                    }
                    Text {
                        horizontal-stretch: 1;
                        min-width: root.flexible-width;
                        preferred-width: root.flexible-width;
                        text: "Name";
                        font-weight: 700;
                    }
                    Text {
                        horizontal-stretch: 1;
                        min-width: root.flexible-width;
                        preferred-width: root.flexible-width;
                        text: "Category";
                        font-weight: 700;
                    }
                    Text {
                        width: root.amount-width;
                        text: "Amount";
                        font-weight: 700;
                        horizontal-alignment: right;
                    }
                }
            }

            list := ListView {
                vertical-stretch: 1;

                // While adding, keep the end of the list (where the new line is) in view as its
                // height becomes known or grows with added entries.
                changed content-height => {
                    if (root.adding) {
                        root.scroll-to-bottom();
                    }
                }

                // Entries and month separators, plus the last row for adding, which takes no
                // space unless adding. ListView items can't have spacing, so each carries the gap
                // below it.
                for row in EntriesStore.entries : VerticalLayout {
                    property <bool> is-new: row.row-type == RowType.new-entry;
                    padding-bottom: !self.is-new || root.adding ? 3px : 0px;

                    if row.row-type == RowType.month : Rectangle {
                        opacity: root.editing ? 0.4 : 1;

                        HorizontalLayout {
                            padding-left: root.line-padding;
                            padding-top: 10px;
                            padding-bottom: 2px;

                            Text {
                                text: row.title;
                                font-size: 16px;
                                font-weight: 600;
                            }
                        }
                    }

                    if row.row-type == RowType.entry && row.id != EntriesStore.editing-id : EntryLine {
                        entry: row;
                        dimmed: root.editing;
                        column-spacing: root.column-spacing;
                        date-width: root.date-width;
                        amount-width: root.amount-width;
                        flexible-width: root.flexible-width;
                        horizontal-padding: root.line-padding;
                        double-clicked(column) => { root.start-edit(row.id, column); }
                    }

                    // Separators have no id, so `editing` is checked too ("" means not editing).
                    if root.editing && row.id == EntriesStore.editing-id : Rectangle {
                        border-width: 1px;
                        border-color: Palette.accent-background;
                        border-radius: 4px;

                        VerticalLayout {
                            padding: 2px;

                            EntryEditor {
                                column-spacing: root.column-spacing;
                                date-width: root.date-width;
                                amount-width: root.amount-width;
                                flexible-width: root.flexible-width;
                                init => {
                                    self.date = row.date;
                                    self.name = row.name;
                                    self.category = row.category;
                                    self.amount = row.amount;
                                    self.focus-column(root.edit-column);
                                }
                                submitted => {
                                    if (is-new) {
                                        // Stay in adding mode for the next entry.
                                        if (EntriesStore.add-entry(self.date, self.name, self.category, self.amount)) {
                                            self.reset();
                                            root.scroll-to-bottom();
                                        }
                                    } else if (EntriesStore.update-entry(row.id, self.date, self.name, self.category, self.amount)) {
                                        root.finish-edit();
                                    }
                                }
                                cancelled => { root.finish-edit(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
