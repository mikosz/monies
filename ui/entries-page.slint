import { ListView, Palette } from "std-widgets.slint";
import { EntriesStore } from "entries-store.slint";
import { EntryEditor } from "entry-editor.slint";
import { EntryColumn, EntryKind, EntryLine, EntryRow } from "entry-line.slint";
import { Page } from "page.slint";

export { EntriesStore, EntryKind, EntryRow }

export component EntriesPage inherits Page {
    title: "Entries";
    description: "";

    // Header, rows and input share these constraints so the columns line up.
    property <length> column-spacing: 8px;
    property <length> date-width: 110px;
    property <length> amount-width: 110px;
    property <length> flexible-width: 100px;
    // Padding inside an entry line; the header uses the same so its titles align.
    property <length> line-padding: 8px;

    // Editing is modal: while a line is edited, everything else is dimmed and disabled.
    property <bool> editing: EntriesStore.editing-id != "";
    // Column to focus when the editor opens.
    property <EntryColumn> edit-column;

    function start-edit(id: string, column: EntryColumn) {
        root.edit-column = column;
        EntriesStore.editing-id = id;
    }

    function finish-edit() {
        EntriesStore.editing-id = "";
        input-row.focus-column(EntryColumn.date);
    }

    VerticalLayout {
        spacing: 4px;

        // Layouts have no opacity, hence the rectangle.
        Rectangle {
            opacity: root.editing ? 0.4 : 1;

            HorizontalLayout {
                padding-left: root.line-padding;
                padding-right: root.line-padding;
                spacing: root.column-spacing;

                Text {
                    width: root.date-width;
                    text: "Date";
                    font-weight: 700;
                }
                Text {
                    horizontal-stretch: 1;
                    min-width: root.flexible-width;
                    preferred-width: root.flexible-width;
                    text: "Name";
                    font-weight: 700;
                }
                Text {
                    horizontal-stretch: 1;
                    min-width: root.flexible-width;
                    preferred-width: root.flexible-width;
                    text: "Category";
                    font-weight: 700;
                }
                Text {
                    width: root.amount-width;
                    text: "Amount";
                    font-weight: 700;
                    horizontal-alignment: right;
                }
            }
        }

        ListView {
            vertical-stretch: 1;

            // ListView items can't have spacing, so each line carries the gap below it.
            for row in EntriesStore.entries : VerticalLayout {
                padding-bottom: 3px;

                if row.id != EntriesStore.editing-id : EntryLine {
                    entry: row;
                    dimmed: root.editing;
                    column-spacing: root.column-spacing;
                    date-width: root.date-width;
                    amount-width: root.amount-width;
                    flexible-width: root.flexible-width;
                    horizontal-padding: root.line-padding;
                    double-clicked(column) => { root.start-edit(row.id, column); }
                }

                if row.id == EntriesStore.editing-id : Rectangle {
                    border-width: 1px;
                    border-color: Palette.accent-background;
                    border-radius: 4px;

                    VerticalLayout {
                        padding: 2px;

                        EntryEditor {
                            column-spacing: root.column-spacing;
                            date-width: root.date-width;
                            amount-width: root.amount-width;
                            flexible-width: root.flexible-width;
                            trap-focus: true;
                            init => {
                                self.date = row.date;
                                self.name = row.name;
                                self.category = row.category;
                                self.amount = row.amount;
                                self.focus-column(root.edit-column);
                            }
                            submitted => {
                                if (EntriesStore.update-entry(row.id, self.date, self.name, self.category, self.amount)) {
                                    root.finish-edit();
                                }
                            }
                            cancelled => { root.finish-edit(); }
                        }
                    }
                }
            }
        }

        input-row := EntryEditor {
            enabled: !root.editing;
            column-spacing: root.column-spacing;
            date-width: root.date-width;
            amount-width: root.amount-width;
            flexible-width: root.flexible-width;
            submitted => {
                if (EntriesStore.add-entry(self.date, self.name, self.category, self.amount)) {
                    self.reset();
                }
            }
        }
    }
}
