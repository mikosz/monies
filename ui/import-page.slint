import { Button, Palette } from "std-widgets.slint";
import { ImportLine, PendingImport } from "import-line.slint";
import { ImportReview } from "import-review.slint";
import { ImportsStore, ReviewedImport } from "imports-store.slint";
import { Page } from "page.slint";
import { ReviewEntry, ReviewRow, ReviewStatus, RowDecision } from "review-line.slint";

export { ImportsStore, PendingImport, ReviewedImport, ReviewEntry, ReviewRow, ReviewStatus, RowDecision }

// Bank statements to import, from files in the format of docs/import-format.md. Each
// statement waits here as a pending import until it's discarded, after confirmation, or
// reviewed and submitted. The counts tell how its lines match the entries. Up/Down select an
// import; Enter, a double click or its Review button open its review (see `ImportReview`).
export component ImportPage inherits Page {
    title: "Import";
    description: "";

    // Lines and the header share these so the columns line up. The fixed columns are just wide
    // enough for their contents (the date and time, the headers of the counts, the button), so
    // the source gets as much of the line as possible.
    property <length> column-spacing: 8px;
    property <length> account-width: 130px;
    property <length> source-width: 100px;
    property <length> created-width: 104px;
    property <length> count-width: 64px;
    property <length> actions-width: 150px;
    property <length> line-padding: 8px;

    property <bool> confirming: ImportsStore.discarding-id != "";
    property <bool> reviewing: ImportsStore.review.id != "";
    // Index of the selected import in the list.
    property <int> selected: 0;

    // The import whose discarding awaits confirmation.
    property <string> discarding-source;
    property <string> discarding-account;

    // Without input fields, the window's undo shortcuts need something focused. The review
    // focuses itself.
    init => {
        if (!root.reviewing) {
            keys.focus();
        }
    }

    changed reviewing => {
        if (!self.reviewing) {
            keys.focus();
        }
    }

    function confirm-discard(id: string, source: string, account: string) {
        root.discarding-source = source;
        root.discarding-account = account;
        ImportsStore.discarding-id = id;
    }

    function finish-confirmation() {
        ImportsStore.discarding-id = "";
        // The review takes the keys back itself.
        if (!root.reviewing) {
            keys.focus();
        }
    }

    function select(index: int) {
        root.selected = Math.max(0, Math.min(index, ImportsStore.imports.length - 1));
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (root.reviewing || root.confirming || ImportsStore.imports.length == 0
                || event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                return reject;
            }
            if (event.text == Key.UpArrow) {
                root.select(root.selected - 1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.select(root.selected + 1);
                return accept;
            }
            if (event.text == Key.Home) {
                root.select(0);
                return accept;
            }
            if (event.text == Key.End) {
                root.select(ImportsStore.imports.length - 1);
                return accept;
            }
            if (event.text == Key.Return) {
                // The selection may be past the end after an import is gone.
                root.select(root.selected);
                ImportsStore.review-import(ImportsStore.imports[root.selected].id);
                return accept;
            }
            return reject;
        }

        // The list is short, so there's no scrolling.
        if !root.reviewing : VerticalLayout {
            alignment: start;
            spacing: 3px;

            Rectangle {
                opacity: root.confirming ? 0.4 : 1;

                HorizontalLayout {
                    padding-bottom: 6px;
                    spacing: root.column-spacing;

                    Text {
                        horizontal-stretch: 1;
                        text: "Pending imports";
                        font-size: 16px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Button {
                        text: "Import file…";
                        enabled: !root.confirming;
                        clicked => {
                            ImportsStore.import-file();
                            keys.focus();
                        }
                    }
                }
            }

            if ImportsStore.imports.length == 0 : Text {
                text: "No pending imports. Import a file of bank statements to review them here.";
                wrap: word-wrap;
            }

            if ImportsStore.imports.length > 0 : Rectangle {
                opacity: root.confirming ? 0.4 : 1;

                HorizontalLayout {
                    padding-left: root.line-padding;
                    padding-right: root.line-padding;
                    spacing: root.column-spacing;

                    Text {
                        width: root.account-width;
                        text: "Account";
                        font-weight: 700;
                    }
                    Text {
                        horizontal-stretch: 1;
                        min-width: root.source-width;
                        preferred-width: root.source-width;
                        text: "Source";
                        font-weight: 700;
                    }
                    Text {
                        width: root.created-width;
                        text: "Added";
                        font-weight: 700;
                    }
                    Text {
                        width: root.count-width;
                        text: "New";
                        font-weight: 700;
                        horizontal-alignment: right;
                    }
                    Text {
                        width: root.count-width;
                        text: "Duplicates";
                        font-weight: 700;
                        horizontal-alignment: right;
                    }
                    Text {
                        width: root.count-width;
                        text: "To review";
                        font-weight: 700;
                        horizontal-alignment: right;
                    }
                    Rectangle {
                        width: root.actions-width;
                    }
                }
            }

            for row[index] in ImportsStore.imports : ImportLine {
                import: row;
                dimmed: root.confirming;
                selected: index == root.selected;
                column-spacing: root.column-spacing;
                account-width: root.account-width;
                source-width: root.source-width;
                created-width: root.created-width;
                count-width: root.count-width;
                actions-width: root.actions-width;
                horizontal-padding: root.line-padding;
                clicked => {
                    root.select(index);
                    keys.focus();
                }
                double-clicked => { ImportsStore.review-import(row.id); }

                Button {
                    text: "Review";
                    enabled: !root.confirming;
                    clicked => { ImportsStore.review-import(row.id); }
                }
                Button {
                    text: "Discard";
                    enabled: !root.confirming;
                    clicked => { root.confirm-discard(row.id, row.source, row.account); }
                }
            }
        }

        if root.reviewing : ImportReview {
            dimmed: root.confirming;
            discard => {
                root.confirm-discard(ImportsStore.review.id, ImportsStore.review.source, ImportsStore.review.account);
            }
        }

        // Asks before discarding an import, like deleting an account permanently on the
        // settings page.
        if root.confirming : Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            TouchArea {}

            Rectangle {
                width: Math.min(420px, parent.width - 32px);
                height: dialog.preferred-height;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 3;
                background: Palette.background;
                border-color: Palette.border;
                border-width: 1px;
                border-radius: 6px;
                drop-shadow-blur: 12px;
                drop-shadow-color: #00000060;

                FocusScope {
                    init => { self.focus(); }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.finish-confirmation();
                            return accept;
                        }
                        return reject;
                    }

                    dialog := VerticalLayout {
                        padding: 16px;
                        spacing: 16px;

                        Text {
                            text: "Discard the import of ‘\{root.discarding-source}’ into ‘\{root.discarding-account}’?";
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;

                            Button {
                                text: "Discard";
                                clicked => {
                                    ImportsStore.discard-import(ImportsStore.discarding-id);
                                    root.finish-confirmation();
                                }
                            }
                            Button {
                                text: "Cancel";
                                clicked => { root.finish-confirmation(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
