import { Palette } from "std-widgets.slint";

export enum EntryKind { expense, income, neutral }

export enum EntryColumn { account, date, name, category, amount }

// What a row of the list of entries is.
export enum RowType {
    entry,
    // Separates months; `title` names the month.
    month,
    // The last row, edited to add a new entry.
    new-entry
}

export struct EntryRow {
    row-type: RowType,
    // For `month` rows.
    title: string,
    // The entry's id, to refer back to it (e.g. when saving an edit).
    id: string,
    // The account's name.
    account: string,
    date: string,
    name: string,
    category: string,
    // The number as typed, e.g. "12.50", to edit.
    amount: string,
    // With the currency's symbol, e.g. "€12.50", to show.
    amount-display: string,
    kind: EntryKind,
    // Whether the entry was imported from a statement rather than typed in. Imported entries
    // stay in their account.
    imported: bool,
    // Every other entry of a month, which is shaded a little differently.
    odd: bool,
}

// Colours of lines of entries and of import rows. They mix the theme's colours, so they suit
// light and dark themes alike.
export global LineColors {
    // Backgrounds of lines, alternating so that neighbours are told apart.
    out property <color> background: Palette.background.mix(Palette.foreground, 0.96);
    out property <color> alternate-background: Palette.background.mix(Palette.foreground, 0.92);
    // Readable on the backgrounds, also when tinted.
    out property <color> expense: Palette.color-scheme == ColorScheme.dark ? #ef5350 : #c62828;
    out property <color> income: Palette.color-scheme == ColorScheme.dark ? #66bb6a : #2e7d32;

    // The background of a line, `odd` telling which of the alternating ones.
    public pure function line-background(odd: bool) -> color {
        return odd ? root.alternate-background : root.background;
    }

    // Hovering mixes in a bit of the text colour: darker on light themes, lighter on dark ones.
    public pure function hovered(background: color) -> color {
        return background.mix(Palette.foreground, 0.92);
    }

    // Amounts are red for expenses and green for income.
    public pure function amount(kind: EntryKind) -> color {
        return kind == EntryKind.expense ? root.expense : kind == EntryKind.income ? root.income : Palette.foreground;
    }
}

// A small icon marking an entry typed in, a pen over a sheet of paper. Imported entries have
// none, being what's expected once statements are imported.
export component TypedInIcon inherits Image {
    source: @image-url("icons/typed-in.svg");
    colorize: Palette.foreground;
    image-fit: contain;
    opacity: 0.7;
    accessible-role: image;
    accessible-label: "Typed in";
}

// One entry in the list, drawn as a card that highlights on hover, starting with an icon if it
// was typed in and with its amount coloured by its kind. Column sizes come from the page so
// lines align with the header and the input row.
export component EntryLine inherits Rectangle {
    in property <EntryRow> entry;
    // Whether the account column is shown; it's left out when there's only one account.
    in property <bool> show-account;
    in property <length> column-spacing;
    in property <length> account-width;
    // Width of the column with the icon of entries typed in.
    in property <length> icon-width;
    in property <length> date-width;
    in property <length> amount-width;
    // Minimum width of the name and category columns, which share the remaining space.
    in property <length> flexible-width;
    // Space between the card's edge and its text; the header uses the same.
    in property <length> horizontal-padding;
    // Greyed out and not interactive, e.g. while another line is being edited.
    in property <bool> dimmed;

    // With the column under the pointer.
    callback double-clicked(EntryColumn);

    property <color> tint: LineColors.line-background(root.entry.odd);

    background: touch.has-hover ? LineColors.hovered(root.tint) : root.tint;
    border-radius: 4px;
    opacity: root.dimmed ? 0.4 : 1;
    animate background, opacity { duration: 100ms; }

    HorizontalLayout {
        padding-left: root.horizontal-padding;
        padding-right: root.horizontal-padding;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: root.column-spacing;

        // Hidden rather than left out, so the columns stay aligned.
        TypedInIcon {
            width: root.icon-width;
            visible: !root.entry.imported;
        }
        if root.show-account : Text {
            width: root.account-width;
            text: root.entry.account;
            overflow: elide;
        }
        date := Text {
            width: root.date-width;
            text: root.entry.date;
        }
        name := Text {
            horizontal-stretch: 1;
            min-width: root.flexible-width;
            preferred-width: root.flexible-width;
            text: root.entry.name;
            overflow: elide;
        }
        category := Text {
            horizontal-stretch: 1;
            min-width: root.flexible-width;
            preferred-width: root.flexible-width;
            text: root.entry.category;
            overflow: elide;
        }
        amount := Text {
            width: root.amount-width;
            text: root.entry.amount-display;
            color: LineColors.amount(root.entry.kind);
            horizontal-alignment: right;
        }
    }

    // Covers the whole line; clicks and context menus will hook in here too.
    touch := TouchArea {
        enabled: !root.dimmed;
        double-clicked => {
            // Columns start where their text starts; the spacing before one counts to the
            // previous column, and the icon to the first.
            root.double-clicked(
                root.show-account && self.mouse-x < date.x ? EntryColumn.account
                : self.mouse-x < name.x ? EntryColumn.date
                : self.mouse-x < category.x ? EntryColumn.name
                : self.mouse-x < amount.x ? EntryColumn.category
                : EntryColumn.amount);
        }
    }
}
