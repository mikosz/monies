import { PendingImport } from "import-line.slint";

// Pending imports and the operations on them, implemented in Rust.
export global ImportsStore {
    // Pending imports of accounts that aren't deleted, in the order they were added.
    in property <[PendingImport]> imports;
    // Whether import files can be picked, which the browser can't do yet.
    in property <bool> can-import-files;

    // Asks for an import file and adds each of its statements as a pending import, or shows
    // why the file can't be imported.
    callback import-file();
    // Drops the import with the id without adding any entries.
    callback discard-import(string);

    // Id of the import whose discarding awaits confirmation, or "" when none does. Everything
    // else is disabled meanwhile.
    in-out property <string> discarding-id;
}
